<?xml version="1.0" encoding="utf-8"?>
<!-- Installed by tool/setup_platforms.dart. Edit this copy in platform/android/. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fb_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/focus_widget_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/fb_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/focus_widget_chip"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:text="FOCUS BLOCKS"
            android:textColor="#0E7490"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fb_streak"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="#56626A"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/fb_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Open the app to start"
        android:textColor="#0B1215"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/fb_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#0B1215"
        android:textSize="14sp" />

    <ProgressBar
        android:id="@+id/fb_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:max="100"
        android:progressBackgroundTint="#B3E8F2"
        android:progressTint="#0E7490"
        android:visibility="gone" />

    <TextView
        android:id="@+id/fb_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#56626A"
        android:textSize="12sp" />
</LinearLayout>
